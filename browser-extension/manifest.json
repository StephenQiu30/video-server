{
  "manifest_version": 3,
  "name": "FrameFetch Browser Session Bridge",
  "description": "Keeps approved provider sessions local to FrameFetch.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://youtube-nocookie.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://*.douyin.com/*",
    "https://douyin.com/*",
    "https://*.iesdouyin.com/*",
    "https://*.xiaohongshu.com/*",
    "https://xiaohongshu.com/*",
    "https://*.x.com/*",
    "https://x.com/*",
    "https://*.twitter.com/*",
    "https://twitter.com/*",
    "https://*.instagram.com/*",
    "https://instagram.com/*",
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "https://*.reddit.com/*",
    "https://reddit.com/*",
    "https://*.pinterest.com/*",
    "https://pinterest.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8101/*",
        "http://localhost:8101/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
