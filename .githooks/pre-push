#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
remote_name=$1
zero=0000000000000000000000000000000000000000
cd "$repository_root"

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$local_oid" = "$zero" ]; then
        continue
    fi
    if [ "$remote_oid" != "$zero" ]; then
        python3 scripts/validate_commit_message.py --range "$remote_oid..$local_oid"
        continue
    fi
    git rev-list --reverse "$local_oid" --not --remotes="$remote_name" |
        while read -r commit_oid; do
            python3 scripts/validate_commit_message.py --commit "$commit_oid"
        done
done

exec python3 scripts/ci.py pre-push
