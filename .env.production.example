# App
APP_NAME="Stephen Video Downloader"
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://your-domain.example
COMPOSE_PROJECT_NAME=stephen-video
WEB_HTTP_PORT=3000
API_HTTP_PORT=8000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
WEB_API_BASE_URL=https://api.your-domain.example

# Database
POSTGRES_DB=video_downloader
POSTGRES_USER=video
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://video:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/video_downloader

# Redis / RQ
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
RQ_QUEUE_NAME=downloads

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Beta access / quota
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=CHANGE_ME_INVITE_CODE
ADMIN_EMAILS=admin@your-domain.example
DEFAULT_DAILY_TASK_QUOTA=10
DEFAULT_STORAGE_QUOTA_BYTES=5368709120

# Download limits
DOWNLOAD_WORK_DIR=/tmp/video-download-workdir
MAX_FILE_SIZE_BYTES=2147483648
MAX_TASK_RUNTIME_SECONDS=7200
GLOBAL_DOWNLOAD_CONCURRENCY=2
PER_USER_DOWNLOAD_CONCURRENCY=1
FILE_RETENTION_HOURS=24
PRESIGNED_URL_TTL_SECONDS=900

# MinIO / S3
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://s3.your-domain.example
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD
S3_BUCKET=video-downloads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
