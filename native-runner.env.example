# Copy to an ignored provider-specific file such as native-runner.youtube.env.
# RUNNER_HMAC_SECRET must exactly match the root .env value.
RUNNER_HMAC_SECRET=development-runner-secret-change-me
RUNNER_EGRESS_PROXY=http://127.0.0.1:13128
RUNNER_WORKSPACE_ROOT=./.native-runner/youtube/work
RUNNER_PROVIDER_SECRET_TEMP_ROOT=./.native-runner/youtube/sessions
RUNNER_ACCESS_MODE=operator_managed
RUNNER_MAX_ACTIVE_TASKS=1
RUNNER_OPERATOR_SESSION_VERSIONS='{"youtube":"browser-profile-v1"}'
RUNNER_OPERATOR_BROWSER_SESSIONS='{"youtube":"chrome:Profile 2"}'
RUNNER_OPERATOR_RETAINED_SESSION_VERSIONS='{}'
RUNNER_OPERATOR_ACCOUNT_BASELINE_ATTESTED=true
RUNNER_ARTIFACT_TRANSPORT=presigned_put
RUNNER_ARTIFACT_DELIVERY_ORIGINS='["http://127.0.0.1:19190"]'
RUNNER_YOUTUBE_POT_BASE_URL=http://127.0.0.1:4416
RUNNER_YOUTUBE_POT_PROVIDER_VERSION=bgutil-http-1.3.1
NATIVE_RUNNER_HOST=127.0.0.1
NATIVE_RUNNER_PORT=19101
