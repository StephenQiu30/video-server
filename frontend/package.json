{
  "name": "video-server-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "Next.js frontend for 帧取",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1 --port 8000",
    "lint": "npm run biome:lint && npm run typecheck",
    "biome:lint": "biome lint .",
    "format:check": "biome check . --linter-enabled=false",
    "openapi": "node scripts/generate-openapi.mjs",
    "openapi:check": "npm run openapi && git diff --exit-code -- src/services/video",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/openapi": "1.14.1",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
