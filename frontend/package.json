{
  "name": "video-server-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "Frontend module for the universal video downloader server",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "npm run biome:lint && npm run typecheck",
    "biome:lint": "biome lint .",
    "format:check": "biome check . --linter-enabled=false",
    "openapi": "openapi2ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.29.3",
    "axios": "^1.19.0",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/openapi": "^1.14.1",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2"
  }
}
