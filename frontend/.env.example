# Linear 个人 API Key；已在 shell 全局配置时可留空。
LINEAR_API_KEY=
# Symphony 轮询的 Linear 项目 slug。
SYMPHONY_LINEAR_PROJECT_SLUG=
# Symphony 创建隔离任务工作区的根目录。
SYMPHONY_WORKSPACE_ROOT=/Users/stephenqiu/Desktop/StephenQiu30/Agents/symphony/workspaces
# 工作区要克隆的仓库与默认目标分支。
SOURCE_REPO_URL=https://github.com/StephenQiu30/video-web.git
SYMPHONY_TARGET_BRANCH=main
# Dashboard 端口与 Docker 宿主机工作区目录。
SYMPHONY_PORT=4000
SYMPHONY_HOST_WORKSPACE_ROOT=./.symphony-workspaces
VIDEO_API_BASE_URL=
VIDEO_API_PROXY_TARGET=http://localhost:19090
OPENAPI_SCHEMA_URL=http://localhost:19090/openapi.json

# Docker default environment
VIDEO_WEB_IMAGE=video-web:local
VIDEO_API_UPSTREAM=host.docker.internal:19090
WEB_BIND=127.0.0.1
WEB_PORT=8000
