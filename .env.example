# ==============================================================================
# UNIFIED CONFIGURATION (MONOREPO ROOT)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SETTINGS (API & WORKER)
# ------------------------------------------------------------------------------
APP_NAME="Stephen Video Downloader"
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

DATABASE_URL="postgresql+psycopg://video:video@127.0.0.1:5432/video_downloader"
REDIS_URL="redis://127.0.0.1:6379/0"
RQ_QUEUE_NAME=downloads

JWT_SECRET_KEY="change-me-in-production-at-least-32-chars-long"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

S3_ENDPOINT_URL="http://127.0.0.1:9000"
S3_PUBLIC_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=video-downloads
S3_REGION=us-east-1

# AI Intelligence Suite
LLM_API_KEY=
LLM_API_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL_NAME="deepseek-chat"
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_BASE_URL="https://api.groq.com/openai/v1"
TRANSCRIPTION_MODEL_NAME="whisper-large-v3"

# Download Config
MAX_FILE_SIZE_BYTES=2147483648
FILE_RETENTION_HOURS=24
GLOBAL_DOWNLOAD_CONCURRENCY=2
PER_USER_DOWNLOAD_CONCURRENCY=1

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (WEB - VITE)
# ------------------------------------------------------------------------------
VITE_SITE_NAME="StephenVideo"
VITE_SITE_URL="http://localhost:3000"
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_BETA_TOOLS=true
