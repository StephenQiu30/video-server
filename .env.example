# Linear 个人 API Key；已在 shell 全局配置时可留空。
LINEAR_API_KEY=
# Symphony 轮询的 Linear 项目 slug。
SYMPHONY_LINEAR_PROJECT_SLUG=
# Symphony 创建隔离任务工作区的根目录。
SYMPHONY_WORKSPACE_ROOT=/Users/stephenqiu/Desktop/StephenQiu30/Agents/symphony/workspaces
# 工作区要克隆的仓库与默认目标分支。
SOURCE_REPO_URL=https://github.com/StephenQiu30/video-server.git
SYMPHONY_TARGET_BRANCH=main
# Dashboard 端口与 Docker 宿主机工作区目录。
SYMPHONY_PORT=4000
SYMPHONY_HOST_WORKSPACE_ROOT=./.symphony-workspaces
