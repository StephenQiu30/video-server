# Host-process connections. Change only when reusing services whose addresses or
# credentials differ from the typed development defaults.
APP_HOST=127.0.0.1
DATABASE_URL=postgresql+asyncpg://video:video@127.0.0.1:15432/video
RABBITMQ_URL=amqp://video:video@127.0.0.1:5673/
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=video-app-access
MINIO_SECRET_KEY=video-app-secret-change-me

# Optional provider overrides. Omit these when using the built-in Ollama defaults.
ANALYSIS_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
OPENAI_API_KEY=replace-with-openai-api-key
