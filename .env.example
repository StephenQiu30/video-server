# Copy this file to .env before running Docker Compose.
# Keep real local secrets in .env and never commit it.

TZ=Asia/Shanghai
# Comma-separated Docker Compose profiles that match configured operator routes.
COMPOSE_PROFILES=

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8111
FRONTEND_HOST_PORT=8101
REQUEST_MAX_BYTES=262144
REQUEST_TIMEOUT_SECONDS=180
TRUSTED_PROXY_CIDRS=["127.0.0.0/8","::1/128"]
METRICS_ACCESS_KEY=development-metrics-access-key-change-me

# Host ports for this project's isolated infrastructure Compose.
HOST_POSTGRES_PORT=15432
HOST_RABBITMQ_PORT=5673
HOST_RABBITMQ_MANAGEMENT_PORT=15673
HOST_VALKEY_PORT=16380
HOST_MINIO_PORT=19190
HOST_MINIO_CONSOLE_PORT=19191
EGRESS_PROXY_HOST_PORT=13128

# Container-to-infrastructure endpoints. Keep service names when
# docker-compose-env.yml is running; replace these with reachable host names
# and published ports when reusing existing infrastructure.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
VALKEY_HOST=valkey
VALKEY_PORT=6379
MINIO_HOST=minio
MINIO_PORT=9000

POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=video
DATABASE_URL=postgresql+asyncpg://video:video@127.0.0.1:15432/video

RABBITMQ_ADMIN_USER=video
RABBITMQ_ADMIN_PASS=video
RABBITMQ_VHOST=video
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_HEARTBEAT_SECONDS=60
RABBITMQ_RECONNECT_INTERVAL_SECONDS=5
RABBITMQ_API_USER=video-api
RABBITMQ_API_PASS=video-api-secret
RABBITMQ_API_URL=amqp://video-api:video-api-secret@rabbitmq:5672/video
RABBITMQ_OUTBOX_USER=video-outbox
RABBITMQ_OUTBOX_PASS=video-outbox-secret
RABBITMQ_OUTBOX_URL=amqp://video-outbox:video-outbox-secret@rabbitmq:5672/video
RABBITMQ_DOWNLOAD_USER=video-download
RABBITMQ_DOWNLOAD_PASS=video-download-secret
RABBITMQ_DOWNLOAD_URL=amqp://video-download:video-download-secret@rabbitmq:5672/video
RABBITMQ_IMPORT_USER=video-import
RABBITMQ_IMPORT_PASS=video-import-secret
RABBITMQ_IMPORT_URL=amqp://video-import:video-import-secret@rabbitmq:5672/video
RABBITMQ_ANALYSIS_USER=video-analysis
RABBITMQ_ANALYSIS_PASS=video-analysis-secret
RABBITMQ_REPORT_USER=video-report
RABBITMQ_REPORT_PASS=video-report-secret
RABBITMQ_REPORT_URL=amqp://video-report:video-report-secret@rabbitmq:5672/video
RABBITMQ_DLQ_USER=video-dlq
RABBITMQ_DLQ_PASS=video-dlq-secret
RABBITMQ_DLQ_URL=amqp://video-dlq:video-dlq-secret@localhost:5673/video
VALKEY_URL=redis://valkey:6379/0
DOWNLOAD_WORKER_THREADS=4
DOWNLOAD_QUEUED_RECOVERY_SECONDS=60

# 本地导入开关：视频与剧本文档上传默认开启，均可显式关闭。
# 关闭对应导入时，API 不允许创建新的上传任务。
MEDIA_IMPORT_ENABLED=true
DOCUMENT_IMPORT_ENABLED=true
IMPORT_QUARANTINE_RETENTION_DAYS=1
# 仅填写逗号分隔的 exact origin（scheme://host[:port]）；禁止通配符和路径。
# docker-compose-env.yml 会在创建或重建仓库自带的 MinIO 时直接应用此值。
MINIO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8101,http://localhost:8101

# MinIO 所有应用进程共用这一组 AK/SK；不要再增加按进程复制的凭据变量。
MINIO_ACCESS_KEY=video-access
MINIO_SECRET_KEY=video-secret-change-me
MINIO_BUCKET=video-artifacts
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:19190

AUTH_JWT_SECRET=development-jwt-secret-change-me-32-bytes
AUTH_JWT_ISSUER=video-server
AUTH_JWT_AUDIENCE=video-web
AUTH_ACCESS_COOKIE_NAME=video_access_token
AUTH_REFRESH_COOKIE_NAME=video_refresh_token
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# This reserved account receives the administrator role only when registration
# also provides the X-Admin-Bootstrap-Secret header.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_SECRET=development-admin-bootstrap-secret-change-me
REQUEST_FINGERPRINT_SECRET=development-fingerprint-secret-change-me
URL_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtdXJsLWtleS0zMi1ieXRlcyEhISE=

RUNNER_BASE_URL=http://media-runner:19100
RUNNER_OPERATOR_BASE_URLS={}
RUNNER_HMAC_SECRET=development-runner-secret-change-me
RUNNER_EGRESS_PROXY=http://egress-proxy:3128
# Provider overrides must name a managed gateway service on the corresponding
# internal Docker network; direct public proxy hostnames are intentionally unreachable.
RUNNER_PROVIDER_EGRESS_PROXIES={}
RUNNER_WORKSPACE_ROOT=/work
RUNNER_MAX_ACTIVE_TASKS=4
# 内部长视频默认边界：24 小时、20 GiB 单文件、40 GiB 工作区、2 小时执行超时。
INSPECT_TIMEOUT_SECONDS=150
ARTICLE_DISCOVERY_TTL_SECONDS=900
ARTICLE_DISCOVERY_TIMEOUT_SECONDS=12
ARTICLE_DISCOVERY_MAX_RESPONSE_BYTES=4194304
ARTICLE_DISCOVERY_MAX_ITEMS=24
ARTICLE_DISCOVERY_MIN_INTERVAL_SECONDS=1
ARTICLE_DISCOVERY_PROXY_URL=
DOWNLOAD_TIMEOUT_SECONDS=7200
MAX_VIDEO_DURATION_SECONDS=86400
MAX_FILE_SIZE_BYTES=21474836480
MAX_WORKSPACE_SIZE_BYTES=42949672960
RUNNER_DOWNLOAD_TIMEOUT_SECONDS=7200
RUNNER_INSPECT_TIMEOUT_SECONDS=120
RUNNER_MAX_DURATION_SECONDS=86400
RUNNER_MAX_OUTPUT_BYTES=21474836480
RUNNER_MAX_WORKSPACE_BYTES=42949672960
# Public YouTube parsing automatically uses the Compose-managed POT sidecar; no user Cookie or PO Token is required.
# Private canary targets. Use only project-owned or explicitly authorized URLs.
# Example shape: [{"target_id":"vimeo-public-1","provider_key":"vimeo","stage":"metadata","access_mode":"anonymous","url":"https://vimeo.com/..."}]
PROVIDER_CANARY_TARGETS=[]
PROVIDER_VERIFIED_KEYS=[]
PEERTUBE_ALLOWED_INSTANCES=[]
PROVIDER_CANARY_METADATA_INTERVAL_SECONDS=21600
PROVIDER_CANARY_MEDIA_INTERVAL_SECONDS=86400
PROVIDER_CANARY_POLL_SECONDS=60
# Optional service-managed session for YouTube content that is not available anonymously.
# On macOS, the host helper refreshes the Chrome Default profile on demand only
# when parsing reaches the YouTube operator route. The route and Compose profile
# remain disabled until RUNNER_OPERATOR_BASE_URLS and COMPOSE_PROFILES opt in.
# Empty uses the current macOS user's Library/Caches/FrameFetch directory.
YOUTUBE_COOKIE_SYNC_DIR=
YOUTUBE_COOKIE_SECRET_DIR=./.provider-secrets/youtube
YOUTUBE_COOKIE_VERSION=chrome-default-v1
RUNNER_OPERATOR_RETAINED_SESSION_VERSIONS={}
YOUTUBE_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
# Optional isolated session runners. Each Provider uses a separate Runner and
# provider-scoped read-only Cookie secret; never mount multiple providers into
# one process.
# Example routing for one generic isolated runner. Dedicated Provider endpoints
# are configured separately below; never share Cookie jars.
# {"x":"http://provider-operator-runner:19100"}
OPERATOR_PROVIDER_KEY=x
OPERATOR_COOKIE_SECRET_DIR=./.provider-secrets/x
OPERATOR_COOKIE_VERSION=
OPERATOR_RETAINED_SESSION_VERSIONS={}
OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
DOUYIN_COOKIE_SECRET_DIR=./.provider-secrets/douyin
DOUYIN_COOKIE_VERSION=
DOUYIN_RETAINED_SESSION_VERSIONS={}
DOUYIN_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
XIAOHONGSHU_COOKIE_SECRET_DIR=./.provider-secrets/xiaohongshu
XIAOHONGSHU_COOKIE_VERSION=
XIAOHONGSHU_RETAINED_SESSION_VERSIONS={}
XIAOHONGSHU_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
REDDIT_COOKIE_SECRET_DIR=./.provider-secrets/reddit
REDDIT_COOKIE_VERSION=
REDDIT_RETAINED_SESSION_VERSIONS={}
REDDIT_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
X_COOKIE_SECRET_DIR=./.provider-secrets/x
X_COOKIE_VERSION=
X_RETAINED_SESSION_VERSIONS={}
X_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
INSTAGRAM_COOKIE_SECRET_DIR=./.provider-secrets/instagram
INSTAGRAM_COOKIE_VERSION=
INSTAGRAM_RETAINED_SESSION_VERSIONS={}
INSTAGRAM_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
# One-time enrolled secrets are validated by the provider on use, not by mtime.
RUNNER_PROVIDER_SESSION_MAX_AGE_SECONDS=0
ANALYSIS_MAX_RUNS_PER_JOB=10
ANALYSIS_QUEUED_RECOVERY_SECONDS=60
ANALYSIS_WORKER_HEARTBEAT_SECONDS=10
ANALYSIS_WORKER_STALE_SECONDS=45
ANALYSIS_MANUAL_RETRY_MIN_INTERVAL_SECONDS=30
ANALYSIS_MANUAL_RETRIES_PER_DAY=20
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MAX_CONNECTIONS_PER_OWNER=4
WEBSOCKET_AUTH_RECHECK_SECONDS=15

# AI Worker 运行在宿主机；模型与线路由 Web Profile 管理。
# 这里只保留宿主机 CLI 二进制路径，未启用第三方 Profile 时固定使用 local-codex。
# 剧本分析还会受 ANALYSIS_ENABLED 总开关约束。
ANALYSIS_ENABLED=true
SCREENPLAY_ANALYSIS_ENABLED=true
ANALYSIS_CODEX_BINARY=codex
ANALYSIS_CLAUDE_BINARY=claude
ANALYSIS_CLAUDE_MAX_TURNS=40
ANALYSIS_FFMPEG_BINARY=ffmpeg
DOWNLOAD_THUMBNAIL_FFMPEG_BINARY=ffmpeg
DOWNLOAD_THUMBNAIL_TIMEOUT_SECONDS=15
DOWNLOAD_THUMBNAIL_MAX_BYTES=2000000
ANALYSIS_FFPROBE_BINARY=ffprobe
# 可选；默认使用系统临时目录。自定义路径必须位于 Git 仓库和 AGENTS.md 管辖目录之外。
# ANALYSIS_WORKSPACE_ROOT=/absolute/path/to/framefetch-analysis
ANALYSIS_MAX_SCREENPLAY_BYTES=2097152
ANALYSIS_SCREENPLAY_SINGLE_CALL_CHARACTERS=120000
ANALYSIS_SCREENPLAY_REWRITE_GLOSSARY_CHUNK_CHARACTERS=20000
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_CHARACTERS=8000
ANALYSIS_MAX_SCREENPLAY_REWRITE_CHUNKS=128
ANALYSIS_SCREENPLAY_REWRITE_CONTEXT_CHARACTERS=1000
ANALYSIS_MAX_SCREENPLAY_REWRITE_OUTPUT_CHARACTERS=400000
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_CALL_ATTEMPTS=2
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_RETRY_DELAY_SECONDS=1
ANALYSIS_DATABASE_URL=postgresql+asyncpg://video:video@localhost:15432/video
ANALYSIS_RABBITMQ_URL=amqp://video-analysis:video-analysis-secret@localhost:5673/video
ANALYSIS_MINIO_ENDPOINT=localhost:19190
