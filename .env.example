# Copy this file to .env only when local defaults need to be changed.

TZ=Asia/Shanghai

# Infrastructure credentials used by both docker-compose.yml and
# docker-compose-env.yml.
POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=video
RABBITMQ_USER=video
RABBITMQ_PASSWORD=video
MINIO_ROOT_USER=video-root
MINIO_ROOT_PASSWORD=video-root-secret-change-me
MINIO_ACCESS_KEY=video-app-access
MINIO_SECRET_KEY=video-app-secret-change-me
MINIO_BUCKET=video-artifacts
MINIO_PUBLIC_ENDPOINT=localhost:19190

# Host-process connections for running the backend outside Docker while using
# docker-compose-env.yml.
APP_HOST=127.0.0.1
DATABASE_URL=postgresql+asyncpg://video:video@127.0.0.1:15432/video
RABBITMQ_URL=amqp://video:video@127.0.0.1:5673/
MINIO_ENDPOINT=127.0.0.1:19190

# Optional provider overrides. Keep these empty when using the built-in Ollama
# defaults.
ANALYSIS_PROVIDER=ollama
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
