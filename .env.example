# LLM analysis defaults to an existing Ollama service and preinstalled model.
ANALYSIS_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ANALYSIS_MODEL=deepseek-r1:8b

# To use hosted DeepSeek instead, set ANALYSIS_PROVIDER=deepseek.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash

# Audio transcription remains an independent ASR provider.
OPENAI_API_KEY=replace-with-openai-api-key
