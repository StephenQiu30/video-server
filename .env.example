# Copy this file to .env before running Docker Compose.
# Keep real local secrets in .env and never commit it.

TZ=Asia/Shanghai

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8101
REQUEST_MAX_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30

# Host ports published by the local docker-compose.yml.
POSTGRES_HOST_PORT=15432
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
MINIO_HOST_PORT=19190
MINIO_CONSOLE_HOST_PORT=19191

POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=video
DATABASE_URL=postgresql+asyncpg://video:video@postgres:5432/video

RABBITMQ_DEFAULT_USER=video
RABBITMQ_DEFAULT_PASS=video
RABBITMQ_URL=amqp://video:video@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0
DOWNLOAD_WORKER_THREADS=4

MINIO_ROOT_USER=video-root
MINIO_ROOT_PASSWORD=video-root-secret-change-me
MINIO_ACCESS_KEY=video-app-access
MINIO_SECRET_KEY=video-app-secret-change-me
MINIO_BUCKET=video-artifacts
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:19190

SESSION_SECRET=development-session-secret-change-me
REQUEST_FINGERPRINT_SECRET=development-fingerprint-secret-change-me
URL_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtdXJsLWtleS0zMi1ieXRlcyEhISE=

RUNNER_BASE_URL=http://media-runner:19100
RUNNER_HMAC_SECRET=development-runner-secret-change-me
RUNNER_EGRESS_PROXY=http://egress-proxy:3128
RUNNER_PROVIDER_EGRESS_PROXIES={}
RUNNER_WORKSPACE_ROOT=/work
RUNNER_MAX_ACTIVE_TASKS=4
ARTIFACT_GC_INTERVAL_SECONDS=300
ARTIFACT_GC_BATCH_SIZE=50
ARTIFACT_DELETE_TIMEOUT_SECONDS=30

ANALYSIS_WORKSPACE_ROOT=/analysis-work
ANALYSIS_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ANALYSIS_MODEL=qwen3:latest
OPENAI_API_KEY=
