# App
APP_NAME="Stephen Video Downloader"
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://localhost:8001,http://localhost:8002,http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://video:video@127.0.0.1:5432/video_downloader
DOCKER_DATABASE_URL=postgresql+psycopg://video:video@host.docker.internal:5432/video_downloader

# Redis / RQ
REDIS_URL=redis://127.0.0.1:6379/0
DOCKER_REDIS_URL=redis://host.docker.internal:6379/0
RQ_QUEUE_NAME=downloads

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Beta access / quota
REGISTRATION_ENABLED=true
REGISTRATION_INVITE_CODE=
ADMIN_EMAILS=
DEFAULT_DAILY_TASK_QUOTA=10
DEFAULT_STORAGE_QUOTA_BYTES=5368709120

# Download limits
DOWNLOAD_WORK_DIR=./tmp/download-workdir
MAX_FILE_SIZE_BYTES=2147483648
MAX_TASK_RUNTIME_SECONDS=7200
GLOBAL_DOWNLOAD_CONCURRENCY=2
PER_USER_DOWNLOAD_CONCURRENCY=1
FILE_RETENTION_HOURS=24
PRESIGNED_URL_TTL_SECONDS=900
YTDLP_COOKIES_FROM_BROWSER=

# MinIO / S3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
DOCKER_S3_ENDPOINT_URL=http://host.docker.internal:9000
DOCKER_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=video-downloads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
