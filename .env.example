# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=19090
APP_PUBLIC_ORIGIN=http://localhost:19090
WEB_ORIGIN=http://localhost:8000
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# PostgreSQL (the URL is consumed by API, worker and Alembic)
DATABASE_URL=postgresql+asyncpg://video:video@postgres:5432/video
POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=replace-with-a-local-password

# RabbitMQ
RABBITMQ_URL=amqp://video:replace-with-a-local-password@rabbitmq:5672/
RABBITMQ_EXCHANGE=video.downloads
RABBITMQ_QUEUE=video.download
RABBITMQ_ROUTING_KEY=video.download
RABBITMQ_PREFETCH_COUNT=2
RABBITMQ_DEFAULT_USER=video
RABBITMQ_DEFAULT_PASS=replace-with-a-local-password

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=video-access
MINIO_SECRET_KEY=replace-with-a-local-secret
MINIO_SECURE=false
MINIO_BUCKET=video-artifacts
MINIO_PRESIGNED_URL_TTL_SECONDS=900
MINIO_ROOT_USER=video-access
MINIO_ROOT_PASSWORD=replace-with-a-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Anonymous session
SESSION_SECRET=replace-with-at-least-32-characters-local-secret
SESSION_COOKIE_NAME=video_session
SESSION_TTL_SECONDS=86400

# Download and worker limits
YTDLP_ALLOWED_EXTRACTORS=default
INSPECT_TIMEOUT_SECONDS=30
INSPECT_TTL_SECONDS=900
DOWNLOAD_TIMEOUT_SECONDS=1800
MAX_VIDEO_DURATION_SECONDS=7200
MAX_FILE_SIZE_BYTES=2147483648
ARTIFACT_TTL_SECONDS=86400
JOB_TOMBSTONE_TTL_SECONDS=604800
WORKER_CONCURRENCY=2
WORKER_TEMP_DIR=/tmp/video-downloads
PROGRESS_UPDATE_INTERVAL_SECONDS=5
HOUSEKEEPING_INTERVAL_SECONDS=300
RUNNING_STALE_AFTER_SECONDS=900

# Symphony integration (optional repository automation)
LINEAR_API_KEY=
SYMPHONY_LINEAR_PROJECT_SLUG=
SYMPHONY_WORKSPACE_ROOT=./.symphony-workspaces
SOURCE_REPO_URL=https://github.com/StephenQiu30/video-server.git
SYMPHONY_TARGET_BRANCH=main
SYMPHONY_PORT=4000
SYMPHONY_HOST_WORKSPACE_ROOT=./.symphony-workspaces
