{
  "private": true,
  "scripts": {
    "test": "bash scripts/validate-repository.sh && PYTHONPATH=apps/api:apps/worker:packages/shared pytest apps/api/tests",
    "start": "./scripts/start.sh local",
    "stop": "./scripts/start.sh docker:down",
    "check:local": "./scripts/check_local_services.sh",
    "dev:install": "PYTHON_BIN=.venv/bin/python ./scripts/dev_install.sh",
    "dev": "./scripts/start.sh local",
    "docker:up": "./scripts/start.sh docker:up",
    "docker:down": "./scripts/start.sh docker:down",
    "docker:logs": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml logs -f",
    "docker:config": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml config"
  }
}
