{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stephen-codex.local/schemas/rights-statement.schema.json",
  "title": "RightsStatement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "locale",
    "statement",
    "statement_sha256",
    "effective_at",
    "expires_at"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^rights-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "locale": {
      "enum": ["zh-CN", "en-US"]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "statement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
