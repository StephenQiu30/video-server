# Copy this file to .env.prod and replace every placeholder before production.

TZ=Asia/Shanghai

APP_ENV=production
METRICS_ACCESS_KEY=replace-with-metrics-scrape-key
APP_HOST=0.0.0.0
APP_PORT=8101
REQUEST_MAX_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30

POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=replace-with-url-safe-database-password
DATABASE_URL=postgresql+asyncpg://video:replace-with-url-safe-database-password@postgres:5432/video

RABBITMQ_ADMIN_USER=video-admin
RABBITMQ_ADMIN_PASS=replace-with-rabbitmq-admin-password
RABBITMQ_VHOST=video
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_MESSAGE_TTL_MS=86400000
RABBITMQ_MAX_LENGTH=10000
RABBITMQ_MAX_LENGTH_BYTES=268435456
RABBITMQ_DELIVERY_LIMIT=5
RABBITMQ_DLQ_MAX_LENGTH=10000
RABBITMQ_DLQ_MAX_LENGTH_BYTES=268435456
RABBITMQ_MIGRATE_LEGACY_QUEUE_ARGUMENTS=false
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_HEARTBEAT_SECONDS=60
RABBITMQ_RECONNECT_INTERVAL_SECONDS=5
RABBITMQ_API_USER=video-api
RABBITMQ_API_PASS=replace-with-rabbitmq-api-password
RABBITMQ_API_URL=amqp://video-api:replace-with-rabbitmq-api-password@rabbitmq:5672/video
RABBITMQ_OUTBOX_USER=video-outbox
RABBITMQ_OUTBOX_PASS=replace-with-rabbitmq-outbox-password
RABBITMQ_OUTBOX_URL=amqp://video-outbox:replace-with-rabbitmq-outbox-password@rabbitmq:5672/video
RABBITMQ_DOWNLOAD_USER=video-download
RABBITMQ_DOWNLOAD_PASS=replace-with-rabbitmq-download-password
RABBITMQ_DOWNLOAD_URL=amqp://video-download:replace-with-rabbitmq-download-password@rabbitmq:5672/video
RABBITMQ_IMPORT_USER=video-import
RABBITMQ_IMPORT_PASS=replace-with-rabbitmq-import-password
RABBITMQ_IMPORT_URL=amqp://video-import:replace-with-rabbitmq-import-password@rabbitmq:5672/video
RABBITMQ_ANALYSIS_USER=video-analysis
RABBITMQ_ANALYSIS_PASS=replace-with-rabbitmq-analysis-password
RABBITMQ_REPORT_USER=video-report
RABBITMQ_REPORT_PASS=replace-with-rabbitmq-report-password
RABBITMQ_REPORT_URL=amqp://video-report:replace-with-rabbitmq-report-password@rabbitmq:5672/video
RABBITMQ_DLQ_USER=video-dlq
RABBITMQ_DLQ_PASS=replace-with-rabbitmq-dlq-password
RABBITMQ_DLQ_URL=amqp://video-dlq:replace-with-rabbitmq-dlq-password@localhost:5673/video
VALKEY_URL=redis://valkey:6379/0
DOWNLOAD_WORKER_THREADS=8
DOWNLOAD_QUEUED_RECOVERY_SECONDS=60

MINIO_ROOT_USER=video-root
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
MINIO_API_ACCESS_KEY=replace-with-minio-api-access-key
MINIO_API_SECRET_KEY=replace-with-minio-api-secret
MINIO_IMPORT_ACCESS_KEY=replace-with-minio-import-access-key
MINIO_IMPORT_SECRET_KEY=replace-with-minio-import-secret
MINIO_DOWNLOAD_ACCESS_KEY=replace-with-minio-download-access-key
MINIO_DOWNLOAD_SECRET_KEY=replace-with-minio-download-secret
MINIO_REPORT_ACCESS_KEY=replace-with-minio-report-access-key
MINIO_REPORT_SECRET_KEY=replace-with-minio-report-secret
MINIO_ANALYSIS_ACCESS_KEY=replace-with-minio-analysis-access-key
MINIO_ANALYSIS_SECRET_KEY=replace-with-minio-analysis-secret
MINIO_CANARY_ACCESS_KEY=replace-with-minio-canary-access-key
MINIO_CANARY_SECRET_KEY=replace-with-minio-canary-secret
MINIO_BUCKET=video-artifacts
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=downloads.example.com
MINIO_PUBLIC_SECURE=true

MEDIA_IMPORT_ENABLED=false
DOCUMENT_IMPORT_ENABLED=false
MEDIA_IMPORT_MAX_BYTES=2147483648
DOCUMENT_IMPORT_MAX_BYTES=52428800
IMPORT_UPLOAD_SESSION_TTL_SECONDS=900
IMPORT_UPLOAD_PART_SIZE_BYTES=33554432
IMPORT_UPLOAD_MAX_PARTS=1000
IMPORT_UPLOAD_MAX_CONCURRENCY=4
IMPORT_QUARANTINE_RETENTION_DAYS=1

AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=video-server
AUTH_JWT_AUDIENCE=video-web
AUTH_ACCESS_COOKIE_NAME=video_access_token
AUTH_REFRESH_COOKIE_NAME=video_refresh_token
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
REQUEST_FINGERPRINT_SECRET=replace-with-another-32-byte-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
URL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

RUNNER_BASE_URL=http://media-runner:19100
RUNNER_OPERATOR_BASE_URLS={}
RUNNER_HMAC_SECRET=replace-with-at-least-32-random-bytes
RUNNER_EGRESS_PROXY=http://egress-proxy:3128
RUNNER_PROVIDER_EGRESS_PROXIES={}
RUNNER_WORKSPACE_ROOT=/work
RUNNER_MAX_ACTIVE_TASKS=8
# Keep real authorized canary URLs in the untracked .env.prod only.
PROVIDER_CANARY_TARGETS=[]
PROVIDER_VERIFIED_KEYS=[]
PEERTUBE_ALLOWED_INSTANCES=[]
PROVIDER_CANARY_METADATA_INTERVAL_SECONDS=21600
PROVIDER_CANARY_MEDIA_INTERVAL_SECONDS=86400
PROVIDER_CANARY_POLL_SECONDS=60
YOUTUBE_COOKIE_SECRET_DIR=/run/secrets/video-server/youtube
YOUTUBE_COOKIE_VERSION=
RUNNER_OPERATOR_RETAINED_SESSION_VERSIONS={}
YOUTUBE_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
OPERATOR_PROVIDER_KEY=tiktok
OPERATOR_COOKIE_SECRET_DIR=/run/secrets/video-server/tiktok
OPERATOR_COOKIE_VERSION=
OPERATOR_RETAINED_SESSION_VERSIONS={}
OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
ARTIFACT_GC_INTERVAL_SECONDS=300
ARTIFACT_GC_BATCH_SIZE=50
ARTIFACT_DELETE_TIMEOUT_SECONDS=30
# User artifacts default to 7 days. Use 2592000 for a 30-day deployment policy.
ARTIFACT_TTL_SECONDS=604800
ARTIFACT_DOWNLOAD_URL_TTL_SECONDS=300
ANALYSIS_REPORT_TTL_SECONDS=604800
ANALYSIS_REPORT_GC_INTERVAL_SECONDS=300
ANALYSIS_REPORT_GC_BATCH_SIZE=50
ANALYSIS_REPORT_ORPHAN_GRACE_SECONDS=3600
ANALYSIS_MAX_RUNS_PER_JOB=10
ANALYSIS_QUEUED_RECOVERY_SECONDS=60
ANALYSIS_WORKER_HEARTBEAT_SECONDS=10
ANALYSIS_WORKER_STALE_SECONDS=45
ANALYSIS_MANUAL_RETRY_MIN_INTERVAL_SECONDS=30
ANALYSIS_MANUAL_RETRIES_PER_DAY=20
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MAX_CONNECTIONS_PER_OWNER=4
WEBSOCKET_AUTH_RECHECK_SECONDS=15

# AI Worker runs on the same host as Compose and reuses an existing CLI OAuth login.
# Keep the three loopback endpoints aligned with docker-compose-prod.yml host ports.
ANALYSIS_ENABLED=true
ANALYSIS_CLI_PROVIDER=codex
ANALYSIS_CODEX_BINARY=codex
ANALYSIS_CODEX_MODEL=gpt-5.6-sol
ANALYSIS_CLAUDE_BINARY=claude
ANALYSIS_CLAUDE_MODEL=sonnet
ANALYSIS_CLAUDE_MAX_TURNS=40
ANALYSIS_FFMPEG_BINARY=ffmpeg
ANALYSIS_FFPROBE_BINARY=ffprobe
ANALYSIS_WORKSPACE_ROOT=./.analysis-work
ANALYSIS_DATABASE_URL=postgresql+asyncpg://video:replace-with-url-safe-database-password@localhost:15432/video
ANALYSIS_RABBITMQ_URL=amqp://video-analysis:replace-with-rabbitmq-analysis-password@localhost:5673/video
ANALYSIS_MINIO_ENDPOINT=localhost:19190
ANALYSIS_MINIO_ACCESS_KEY=replace-with-minio-analysis-access-key
ANALYSIS_MINIO_SECRET_KEY=replace-with-minio-analysis-secret
