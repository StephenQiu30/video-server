# Copy this file to .env.prod and replace every placeholder before production.

TZ=Asia/Shanghai

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8101
REQUEST_MAX_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30

POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=replace-with-url-safe-database-password
DATABASE_URL=postgresql+asyncpg://video:replace-with-url-safe-database-password@postgres:5432/video

RABBITMQ_DEFAULT_USER=video
RABBITMQ_DEFAULT_PASS=replace-with-url-safe-rabbitmq-password
RABBITMQ_URL=amqp://video:replace-with-url-safe-rabbitmq-password@rabbitmq:5672/
VALKEY_URL=redis://valkey:6379/0
DOWNLOAD_WORKER_THREADS=8

MINIO_ROOT_USER=video-root
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
MINIO_ACCESS_KEY=replace-with-limited-minio-access-key
MINIO_SECRET_KEY=replace-with-limited-minio-secret
MINIO_BUCKET=video-artifacts
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=downloads.example.com
MINIO_PUBLIC_SECURE=true

AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=video-server
AUTH_JWT_AUDIENCE=video-web
AUTH_ACCESS_COOKIE_NAME=video_access_token
AUTH_REFRESH_COOKIE_NAME=video_refresh_token
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
REQUEST_FINGERPRINT_SECRET=replace-with-another-32-byte-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
URL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

RUNNER_BASE_URL=http://media-runner:19100
RUNNER_HMAC_SECRET=replace-with-at-least-32-random-bytes
RUNNER_EGRESS_PROXY=http://egress-proxy:3128
RUNNER_PROVIDER_EGRESS_PROXIES={}
RUNNER_WORKSPACE_ROOT=/work
RUNNER_MAX_ACTIVE_TASKS=8
ARTIFACT_GC_INTERVAL_SECONDS=300
ARTIFACT_GC_BATCH_SIZE=50
ARTIFACT_DELETE_TIMEOUT_SECONDS=30

ANALYSIS_WORKSPACE_ROOT=/analysis-work
ANALYSIS_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ANALYSIS_MODEL=qwen3:latest
OPENAI_API_KEY=replace-with-openai-api-key
