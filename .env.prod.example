# Copy to .env.prod and replace every placeholder before deployment.
APP_ENV=production
APP_HOST=0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=19090
APP_PUBLIC_ORIGIN=https://api.example.com
WEB_ORIGIN=https://video.example.com
LOG_LEVEL=INFO
APP_VERSION=0.1.0
VIDEO_SERVER_IMAGE=replace-with-registry/video-server:0.1.0

DATABASE_URL=postgresql+asyncpg://video:replace-with-url-encoded-password@postgres:5432/video
COMPOSE_DATABASE_URL=postgresql+asyncpg://video:replace-with-url-encoded-password@postgres:5432/video
POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=replace-with-strong-database-password

RABBITMQ_URL=amqp://video:replace-with-url-encoded-password@rabbitmq:5672/
COMPOSE_RABBITMQ_URL=amqp://video:replace-with-url-encoded-password@rabbitmq:5672/
RABBITMQ_EXCHANGE=video.downloads
RABBITMQ_QUEUE=video.download
RABBITMQ_ROUTING_KEY=video.download
RABBITMQ_PREFETCH_COUNT=2
RABBITMQ_DEFAULT_USER=video
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password

MINIO_ENDPOINT=minio:9000
COMPOSE_MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=objects.example.com
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-strong-minio-secret
# The bundled MinIO service uses HTTP on the private Compose network.
MINIO_SECURE=false
MINIO_BUCKET=video-artifacts
MINIO_PRESIGNED_URL_TTL_SECONDS=900
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-strong-minio-secret
MINIO_API_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=video_session
SESSION_TTL_SECONDS=86400

YTDLP_ALLOWED_EXTRACTORS=default
INSPECT_TIMEOUT_SECONDS=30
INSPECT_TTL_SECONDS=900
DOWNLOAD_TIMEOUT_SECONDS=1800
MAX_VIDEO_DURATION_SECONDS=7200
MAX_FILE_SIZE_BYTES=2147483648
ARTIFACT_TTL_SECONDS=86400
JOB_TOMBSTONE_TTL_SECONDS=604800
WORKER_CONCURRENCY=2
PROGRESS_UPDATE_INTERVAL_SECONDS=5
HOUSEKEEPING_INTERVAL_SECONDS=300
RUNNING_STALE_AFTER_SECONDS=900
