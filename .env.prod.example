# Application image.
SERVER_IMAGE=registry.example.com/video-server:0.1.0

# Infrastructure credentials. Keep database and RabbitMQ passwords URL-safe.
POSTGRES_PASSWORD=replace-with-url-safe-database-password
RABBITMQ_PASSWORD=replace-with-url-safe-rabbitmq-password
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
MINIO_ACCESS_KEY=replace-with-limited-minio-access-key
MINIO_SECRET_KEY=replace-with-limited-minio-secret
MINIO_PUBLIC_ENDPOINT=downloads.example.com

# API and runner secrets.
SESSION_SECRET=replace-with-at-least-32-random-bytes
REQUEST_FINGERPRINT_SECRET=replace-with-another-32-byte-random-secret
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
URL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
RUNNER_HMAC_SECRET=replace-with-at-least-32-random-bytes

# LLM analysis provider: deepseek or ollama.
ANALYSIS_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash
# Ollama deployments can instead provide an internal endpoint and installed model.
OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_ANALYSIS_MODEL=deepseek-r1:8b

# Audio transcription provider.
OPENAI_API_KEY=replace-with-openai-api-key
