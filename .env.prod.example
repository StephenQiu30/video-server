# Copy to .env.prod, replace every replace-with-* value, and keep it out of Git.
TZ=Asia/Shanghai

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8101
APP_HOST_BIND=0.0.0.0
APP_HOST_PORT=8101
METRICS_ACCESS_KEY=replace-with-metrics-scrape-key
REQUEST_MAX_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30

# Existing host services reached from containers through host.docker.internal.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=replace-with-url-safe-database-password
DATABASE_URL=postgresql+asyncpg://video:replace-with-url-safe-database-password@host.docker.internal:5432/video

RABBITMQ_VHOST=video
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_MIGRATE_LEGACY_QUEUE_ARGUMENTS=false
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_HEARTBEAT_SECONDS=60
RABBITMQ_RECONNECT_INTERVAL_SECONDS=5
RABBITMQ_API_USER=video-api
RABBITMQ_API_PASS=replace-with-rabbitmq-api-password
RABBITMQ_API_URL=amqp://video-api:replace-with-rabbitmq-api-password@host.docker.internal:5672/video
RABBITMQ_OUTBOX_USER=video-outbox
RABBITMQ_OUTBOX_PASS=replace-with-rabbitmq-outbox-password
RABBITMQ_OUTBOX_URL=amqp://video-outbox:replace-with-rabbitmq-outbox-password@host.docker.internal:5672/video
RABBITMQ_DOWNLOAD_USER=video-download
RABBITMQ_DOWNLOAD_PASS=replace-with-rabbitmq-download-password
RABBITMQ_DOWNLOAD_URL=amqp://video-download:replace-with-rabbitmq-download-password@host.docker.internal:5672/video
RABBITMQ_IMPORT_USER=video-import
RABBITMQ_IMPORT_PASS=replace-with-rabbitmq-import-password
RABBITMQ_IMPORT_URL=amqp://video-import:replace-with-rabbitmq-import-password@host.docker.internal:5672/video
RABBITMQ_ANALYSIS_USER=video-analysis
RABBITMQ_ANALYSIS_PASS=replace-with-rabbitmq-analysis-password
RABBITMQ_REPORT_USER=video-report
RABBITMQ_REPORT_PASS=replace-with-rabbitmq-report-password
RABBITMQ_REPORT_URL=amqp://video-report:replace-with-rabbitmq-report-password@host.docker.internal:5672/video
RABBITMQ_DLQ_USER=video-dlq
RABBITMQ_DLQ_PASS=replace-with-rabbitmq-dlq-password
RABBITMQ_DLQ_URL=amqp://video-dlq:replace-with-rabbitmq-dlq-password@host.docker.internal:5672/video
VALKEY_HOST=host.docker.internal
VALKEY_PORT=6379
VALKEY_URL=redis://host.docker.internal:6379/0
DOWNLOAD_WORKER_THREADS=8
DOWNLOAD_QUEUED_RECOVERY_SECONDS=60

# MinIO 所有应用进程共用这一组 AK/SK；部署前替换为真实凭据。
MINIO_HOST=host.docker.internal
MINIO_PORT=19190
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret
MINIO_BUCKET=video-artifacts
MINIO_ENDPOINT=host.docker.internal:19190
MINIO_PUBLIC_ENDPOINT=downloads.example.com
MINIO_INTERNAL_SECURE=false
MINIO_PUBLIC_SECURE=true
MINIO_CORS_ALLOWED_ORIGINS=https://app.example.com

# 本地导入能力开关；如未部署导入 Worker 和对象存储策略，请显式关闭。
MEDIA_IMPORT_ENABLED=false
DOCUMENT_IMPORT_ENABLED=true
IMPORT_QUARANTINE_RETENTION_DAYS=1

AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=video-server
AUTH_JWT_AUDIENCE=video-web
AUTH_ACCESS_COOKIE_NAME=video_access_token
AUTH_REFRESH_COOKIE_NAME=video_refresh_token
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
REQUEST_FINGERPRINT_SECRET=replace-with-another-32-byte-random-secret
URL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

RUNNER_BASE_URL=http://media-runner:19100
RUNNER_OPERATOR_BASE_URLS={}
RUNNER_HMAC_SECRET=replace-with-at-least-32-random-bytes
RUNNER_EGRESS_PROXY=http://egress-proxy:3128
RUNNER_PROVIDER_EGRESS_PROXIES={}
RUNNER_WORKSPACE_ROOT=/work
RUNNER_MAX_ACTIVE_TASKS=8
# Public YouTube parsing automatically uses the Compose-managed POT sidecar; no user Cookie or PO Token is required.
PROVIDER_CANARY_TARGETS=[]
PROVIDER_VERIFIED_KEYS=[]
PEERTUBE_ALLOWED_INSTANCES=[]
PROVIDER_CANARY_METADATA_INTERVAL_SECONDS=21600
PROVIDER_CANARY_MEDIA_INTERVAL_SECONDS=86400
PROVIDER_CANARY_POLL_SECONDS=60

# Optional service-managed session for YouTube content that is not available anonymously.
# Public links do not require this session or any user-provided Cookie.
YOUTUBE_COOKIE_SECRET_DIR=/run/secrets/video-server/youtube
YOUTUBE_COOKIE_VERSION=
RUNNER_OPERATOR_RETAINED_SESSION_VERSIONS={}
YOUTUBE_OPERATOR_ACCOUNT_BASELINE_ATTESTED=false
OPERATOR_PROVIDER_KEY=tiktok
OPERATOR_COOKIE_SECRET_DIR=/run/secrets/video-server/tiktok
OPERATOR_COOKIE_VERSION=
# 为每个部署生成并长期保持不变的 19 位 TikTok 设备标识。
TIKTOK_DEVICE_ID=
OPERATOR_RETAINED_SESSION_VERSIONS={}
OPERATOR_ACCOUNT_BASELINE_ATTESTED=false

ANALYSIS_MAX_RUNS_PER_JOB=10
ANALYSIS_QUEUED_RECOVERY_SECONDS=60
ANALYSIS_WORKER_HEARTBEAT_SECONDS=10
ANALYSIS_WORKER_STALE_SECONDS=45
ANALYSIS_MANUAL_RETRY_MIN_INTERVAL_SECONDS=30
ANALYSIS_MANUAL_RETRIES_PER_DAY=20
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MAX_CONNECTIONS_PER_OWNER=4
WEBSOCKET_AUTH_RECHECK_SECONDS=15

# 剧本分析同时受 ANALYSIS_ENABLED 与 SCREENPLAY_ANALYSIS_ENABLED 控制。
ANALYSIS_ENABLED=true
SCREENPLAY_ANALYSIS_ENABLED=true
ANALYSIS_CLI_PROVIDER=codex
ANALYSIS_CODEX_BINARY=codex
ANALYSIS_CODEX_MODEL=gpt-5.6-sol
ANALYSIS_CLAUDE_BINARY=claude
ANALYSIS_CLAUDE_MODEL=sonnet
ANALYSIS_CLAUDE_MAX_TURNS=40
ANALYSIS_FFMPEG_BINARY=ffmpeg
ANALYSIS_FFPROBE_BINARY=ffprobe
ANALYSIS_WORKSPACE_ROOT=./.analysis-work
ANALYSIS_MAX_SCREENPLAY_BYTES=2097152
ANALYSIS_SCREENPLAY_SINGLE_CALL_CHARACTERS=120000
ANALYSIS_SCREENPLAY_REWRITE_GLOSSARY_CHUNK_CHARACTERS=20000
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_CHARACTERS=8000
ANALYSIS_MAX_SCREENPLAY_REWRITE_CHUNKS=128
ANALYSIS_SCREENPLAY_REWRITE_CONTEXT_CHARACTERS=1000
ANALYSIS_MAX_SCREENPLAY_REWRITE_OUTPUT_CHARACTERS=400000
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_CALL_ATTEMPTS=2
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_RETRY_DELAY_SECONDS=1
ANALYSIS_DATABASE_URL=postgresql+asyncpg://video:replace-with-url-safe-database-password@localhost:5432/video
ANALYSIS_RABBITMQ_URL=amqp://video-analysis:replace-with-rabbitmq-analysis-password@localhost:5672/video
ANALYSIS_MINIO_ENDPOINT=localhost:19190
